<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZomboidGuide.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ZomboidGuide.Views.CompanionOverlayView"
             x:DataType="vm:CompanionOverlayViewModel">
    <StackPanel Margin="8"
                Spacing="10">
        <TextBlock Classes="title"
                   FontSize="22"
                   Text="{Binding Title}"/>

        <Border Classes="item-card"
                Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock VerticalAlignment="Center"
                           Classes="item-title"
                           Text="Port"/>
                <TextBox Grid.Column="1"
                         Margin="8,0,0,0"
                         Width="120"
                         Text="{Binding PortText, Mode=TwoWay}"/>
                <Button Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Margin="8,0,0,0"
                        Command="{Binding ToggleServerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="Play"
                                               Width="16"
                                               Height="16"
                                               IsVisible="{Binding IsServerStopped}"/>
                        <material:MaterialIcon Kind="Stop"
                                               Width="16"
                                               Height="16"
                                               IsVisible="{Binding IsServerRunning}"/>
                        <TextBlock Text="{Binding ToggleServerButtonText}"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                    <material:MaterialIcon Kind="AlertCircleOutline"
                                           Width="14"
                                           Height="14"/>
                    <TextBlock Classes="caption"
                               Text="{Binding StatusText}"/>
                </StackPanel>

                <ToggleSwitch Grid.Row="2"
                              Grid.ColumnSpan="4"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              OffContent="Autostart Off"
                              OnContent="Autostart On"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}"/>

                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="4"
                           Margin="0,10,0,0"
                           Classes="caption"
                           Text="OBS URL"/>
                <TextBox Grid.Row="4"
                         Grid.ColumnSpan="2"
                         Margin="0,6,0,0"
                         IsReadOnly="True"
                         Text="{Binding OverlayUrl}"/>
                <Button Grid.Row="4"
                        Grid.Column="2"
                        Margin="8,6,0,0"
                        Command="{Binding CopyOverlayUrlCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                        <TextBlock Text="Copy"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4"
                        Grid.Column="3"
                        Margin="8,6,0,0"
                        Command="{Binding OpenOverlayInBrowserCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <material:MaterialIcon Kind="OpenInNew" Width="16" Height="16"/>
                        <TextBlock Text="Open"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
