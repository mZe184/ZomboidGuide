<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZomboidGuide.ViewModels"
             x:Class="ZomboidGuide.Views.CompanionSurvivalView"
             x:DataType="vm:CompanionSurvivalViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="10">
            <TextBlock Classes="title"
                       FontSize="22"
                       Text="{Binding Title}"/>

            <Grid ColumnDefinitions="*,10,*">
                <Border Classes="item-card"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="item-title"
                                   Text="{Binding CombatSectionTitle}"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding KillsTotalLineText}"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding KillsThisSessionLineText}"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding KillsPerHourLineText}"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding TimeSurvivedLineText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Classes="item-card"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{Binding DangerDisplayBrush}"
                                   Text="{Binding DangerDisplayText}"/>
                        <TextBlock Classes="caption"
                                   Text="{Binding DangerIndexLineText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="item-card"
                    Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Classes="item-title"
                               Text="{Binding TopIssuesSectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding TopIssues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="caption"
                                           Text="{Binding .}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="item-card"
                    Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Classes="item-title"
                               Text="{Binding ActiveMoodlesSectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding ActiveMoodles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompanionMoodleIconViewModel">
                                <Border Classes="item-card"
                                        Padding="4"
                                        Margin="0,0,6,6">
                                    <Image Width="60"
                                           Height="60"
                                           Source="{Binding Icon}"
                                           ToolTip.Tip="{Binding Label}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="item-card"
                    Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Classes="item-title"
                               Text="{Binding CurrentVitalsSectionTitle}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding FatigueLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding FatigueValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding TirednessLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding TirednessValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding EnduranceLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding EnduranceValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding HungerLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding HungerValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding ThirstLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ThirstValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding PainLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding PainValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding OutOfBreathLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OutOfBreathValue}"/>
                    <TextBlock Classes="caption"
                               Text="{Binding QueasyLineText}"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding QueasyValue}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


