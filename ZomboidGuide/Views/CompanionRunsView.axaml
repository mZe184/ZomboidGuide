<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZomboidGuide.ViewModels"
             x:Class="ZomboidGuide.Views.CompanionRunsView"
             x:DataType="vm:CompanionRunsViewModel">
    <StackPanel Margin="8"
                Spacing="10">
        <TextBlock Classes="title"
                   FontSize="22"
                   Text="{Binding Title}"/>
        <Border Classes="item-card"
                Height="120"
                Padding="10">
            <TextBlock Classes="item-title"
                       Text="{Binding SectionA}"/>
        </Border>
        <Border Classes="item-card"
                Height="120"
                Padding="10">
            <TextBlock Classes="item-title"
                       Text="{Binding SectionB}"/>
        </Border>
        <Border Classes="item-card"
                Height="120"
                Padding="10">
            <TextBlock Classes="item-title"
                       Text="{Binding SectionC}"/>
        </Border>
    </StackPanel>
</UserControl>
