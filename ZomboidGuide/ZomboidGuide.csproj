<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Platforms>AnyCPU;x64</Platforms>
        <UseAppHost>true</UseAppHost>
        <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
        <Nullable>enable</Nullable>
        <Version>0.0.15</Version>
        <AssemblyVersion>0.0.15.0</AssemblyVersion>
        <FileVersion>0.0.15.0</FileVersion>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
        <AvaloniaResource Include="Images\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.1" />
        <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Material.Icons.Avalonia" Version="2.4.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    </ItemGroup>

    <Target Name="RemoveStaleSelfContainedHostArtifacts" BeforeTargets="Build" Condition="'$(SelfContained)' != 'true' and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64')">
        <ItemGroup>
            <_StaleHostArtifacts Include="$(OutputPath)dotnet.exe" />
            <_StaleHostArtifacts Include="$(OutputPath)dotnet.dll" />
            <_StaleHostArtifacts Include="$(OutputPath)dotnet.runtimeconfig.json" />
            <_StaleHostArtifacts Include="$(OutputPath)hostfxr.dll" />
            <_StaleHostArtifacts Include="$(OutputPath)hostpolicy.dll" />
            <_StaleHostArtifacts Include="$(OutputPath)coreclr.dll" />
            <_StaleHostArtifacts Include="$(OutputPath)clrjit.dll" />
            <_StaleHostArtifacts Include="$(OutputPath)createdump.exe" />
        </ItemGroup>
        <Delete Files="@(_StaleHostArtifacts)" TreatErrorsAsWarnings="true" />
    </Target>

</Project>
